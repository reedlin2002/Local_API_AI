{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://reedlin2002.github.io"
    ]
  },
  "Upload": {
    "MaxBytes": 10485760
  },
  "Inference": {
    "ImageClassifierModelPath": "Models/resnet50-v2-7.onnx",
    "ImageNetLabelsPath": "Models/imagenet_labels.txt",
    "TessdataPath": "tessdata",
    "OcrLanguages": "eng+chi_tra"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "TextModel": "llama2",
    "AgentModel": "mistral",
    "VisionModel": "llava",
    "TimeoutSeconds": 180,
    "MaxAgentSteps": 4
  }
}
